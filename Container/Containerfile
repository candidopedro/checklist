# Baseado no RHEL 9 UBI minimal
FROM registry.access.redhat.com/ubi9/python-39:latest

USER root

# Instalar pacotes de desenvolvimento para pyodbc e driver ODBC
RUN yum -y install \
    gcc-c++ \
    make \
    unixODBC \
    unixODBC-devel \
    && yum clean all

# Copiar driver ODBC e instalar
COPY Container/msodbcsql18-18.5.1.1-1.x86_64.rpm /tmp/
RUN ACCEPT_EULA=Y yum -y localinstall /tmp/msodbcsql18-18.5.1.1-1.x86_64.rpm && \
    rm -f /tmp/msodbcsql18-18.5.1.1-1.x86_64.rpm && \
    # Registrar driver manualmente em odbcinst.ini
    echo "[ODBC Driver 18 for SQL Server]" >> /etc/odbcinst.ini && \
    echo "Description=Microsoft ODBC Driver 18 for SQL Server" >> /etc/odbcinst.ini && \
    echo "Driver=/opt/microsoft/msodbcsql18/lib64/libmsodbcsql-18.5.so" >> /etc/odbcinst.ini && \
    echo "UsageCount=1" >> /etc/odbcinst.ini

# Criar diretório de logs com permissão para OpenShift
RUN mkdir -p /app/LOGs && chown -R 1001:0 /app/LOGs

# Definir diretório de trabalho
WORKDIR /app

# Copiar código da aplicação e requirements
COPY checklist_base/ /app/checklist_base/
COPY requirements.txt /app/requirements.txt

# Instalar dependências Python
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Garantir pyodbc instalado
RUN pip install --no-cache-dir pyodbc

RUN chmod 777 -R .

# Comando padrão
CMD ["python", "checklist_base/main_tribunais.py"]
